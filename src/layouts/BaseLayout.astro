---
import { Font } from 'astro:assets'
import { getEntry } from 'astro:content'
import '../styles/global.css'
import { type Locale, useTranslations, otherLocale, LOCALE_LABELS } from '../i18n/ui'
import { sectionUrl } from '../i18n/routes'

interface Props {
  locale: Locale
  title: string
  description: string
  /** Endereco da mesma pagina no outro idioma; ausente quando nao ha traducao. */
  alternateHref?: string
}

const { locale, title, description, alternateHref } = Astro.props
const translate = useTranslations(locale)
const other = otherLocale(locale)

const navItems = [
  { href: sectionUrl(locale, 'projects'), label: translate('nav.projects') },
  { href: sectionUrl(locale, 'notes'), label: translate('nav.notes') },
  { href: sectionUrl(locale, 'system'), label: translate('nav.system') },
  { href: sectionUrl(locale, 'about'), label: translate('nav.about') },
]

const currentPath = Astro.url.pathname
const canonical = new URL(currentPath, Astro.site)

/** Os links do rodape saem do perfil: um endereco, um lugar para editar. */
const profile = await getEntry('profile', locale)
const socialLinks = (profile?.data.links ?? []).filter((link) => link.rel === 'github' || link.rel === 'linkedin')
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b1121" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {alternateHref && <link rel="alternate" hreflang={other} href={new URL(alternateHref, Astro.site).href} />}
    <link rel="alternate" hreflang={locale} href={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-libre-franklin" preload />
    <Font cssVariable="--font-literata" />
    <Font cssVariable="--font-ibm-plex-mono" />
  </head>

  <body class="min-h-screen flex flex-col antialiased">
    <a
      href="#main-content"
      class="ui sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-paper"
    >
      {translate('nav.skipToContent')}
    </a>

    <header class="shell grid grid-cols-[1fr_auto] items-center gap-x-6 gap-y-4 py-7 md:grid-cols-[1fr_auto_1fr]">
      <a href={sectionUrl(locale, 'home')} class="ui nav-link text-2xl font-bold tracking-[-0.02em]">
        Rodrigo Norys
      </a>

      <nav class="ui col-span-2 row-start-2 md:col-span-1 md:row-start-auto" aria-label={translate('nav.label')}>
        <ul class="flex flex-wrap gap-x-8 gap-y-2 text-sm">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={currentPath.startsWith(item.href) ? 'page' : undefined}
                class="nav-link block border-b-2 border-transparent pb-1 text-muted transition-colors hover:text-ink aria-[current=page]:border-ink aria-[current=page]:text-ink"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="justify-self-end">
        {alternateHref && (
          <a href={alternateHref} class="ui nav-link text-sm text-muted transition-colors hover:text-ink" lang={other}>
            {LOCALE_LABELS[other]}
          </a>
        )}
      </div>
    </header>

    <main id="main-content" class="shell flex-1 pb-20">
      <slot />
    </main>

    <footer class="shell">
      <div class="ui flex flex-col items-center gap-5 border-t border-rule py-10 md:flex-row md:justify-between">
        <a href={sectionUrl(locale, 'home')} class="nav-link text-xl font-bold tracking-[-0.02em]">Rodrigo Norys</a>
        <p class="text-[0.8125rem] text-muted">{translate('footer.credit')} · sisbodeveloper.com.br</p>
        {socialLinks.length > 0 && (
          <ul class="flex gap-5 text-[0.8125rem]">
            {socialLinks.map((link) => (
              <li><a href={link.href} class="nav-link text-muted transition-colors hover:text-ink">{link.label}</a></li>
            ))}
          </ul>
        )}
      </div>
    </footer>
  </body>
</html>
