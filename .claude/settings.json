{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-dados-sensiveis.sh",
            "statusMessage": "Verificando comando contra artefatos sensiveis...",
            "timeout": 15
          }
        ]
      }
    ],

    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/registrar-carga.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/conferir-alinhamento.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],

    "ConfigChange": [
      {
        "matcher": "project_settings|skills",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/conferir-alinhamento.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
